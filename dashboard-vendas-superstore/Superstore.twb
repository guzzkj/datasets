      <column caption='Mês de Retorno' datatype='date' datatype-customized='true' default-format='*mm-yyyy' name='[Calculation_219550538829504512]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, [Calculation_624030045325262849], [Calculation_624030045325160448]))' />
      </column>
      <column caption='Sales Int' datatype='real' default-format='C1033%' name='[Calculation_219550538835984386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE([Sales], &quot;.&quot;, &quot;&quot;))' />
      </column>
      <column caption='Profit Int' datatype='real' default-format='C1033%' name='[Calculation_219550538836201475]' role='measure' type='quantitative'>
