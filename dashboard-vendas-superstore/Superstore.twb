        <calculation class='tableau' formula='SUM([Calculation_219550538836201475]) / SUM([Calculation_219550538835984386])' />
      </column>
      <column caption='Data da Primeira Compra' datatype='date' name='[Calculation_624030045325160448]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : MIN([Order Date]) }' />
      </column>
      <column caption='Meses Desde a Primeira Compra' datatype='integer' name='[Calculation_624030045325262849]' role='measure' type='quantitative'>
